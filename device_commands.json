{
  "devices": {
    "tesla_powerwall_v1": {
      "description": "Tesla Powerwall (v1 or v2 with local gateway)",
      "commands": {
        "get_charge_level": {
          "description": "Get current state of energy (SOE / battery percentage)",
          "protocol": "http",
          "request": {
            "method": "GET",
            "path": "/api/system_status/soe",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response_mapping": {
            "charge_percentage": "percentage"
          }
        },
        "get_meters": {
          "description": "Get aggregate meter readings (solar, grid, load, battery)",
          "protocol": "http",
          "request": {
            "method": "GET",
            "path": "/api/meters/aggregates",
            "headers": {
              "Accept": "application/json"
            }
          },
          "response_mapping": {
            "solar_power_w": "solar.instant_power",
            "grid_power_w": "site.instant_power",
            "load_power_w": "load.instant_power",
            "battery_power_w": "battery.instant_power"
          }
        },
        "get_vitals": {
          "description": "Get system vitals and status",
          "protocol": "http",
          "request": {
            "method": "GET",
            "path": "/api/1/vitals",
            "headers": {
              "Accept": "application/json"
            }
          }
        }
      }
    },
    "homewizard_p1": {
      "description": "HomeWizard Wi-Fi P1 Meter",
      "commands": {
        "get_data": {
          "description": "Get current meter readings",
          "protocol": "http",
          "request": {
            "method": "GET",
            "path": "/api/v1/data",
            "headers": {}
          },
          "response_mapping": {
            "active_power_w": "active_power_w",
            "total_power_import_kwh": "total_power_import_kwh",
            "total_power_export_kwh": "total_power_export_kwh"
          }
        }
      }
    },
    "sma_sunnyboy_modbus": {
      "description": "SMA Sunny Boy Inverter (Modbus TCP)",
      "commands": {
        "get_active_power": {
          "description": "Get current active power production in Watts",
          "protocol": "modbus",
          "request": {
            "port": 502,
            "unit_id": 3,
            "function": 3,
            "address": 30775,
            "count": 2
          },
          "response_mapping": {
            "solar_power_w": {
              "type": "S32",
              "scale": 1,
              "index": 0
            }
          }
        },
        "get_total_yield": {
          "description": "Get total energy yield in Watt-hours",
          "protocol": "modbus",
          "request": {
            "port": 502,
            "unit_id": 3,
            "function": 3,
            "address": 30513,
            "count": 4
          },
          "response_mapping": {
            "total_yield_wh": {
              "type": "U64",
              "scale": 1,
              "index": 0
            }
          }
        },
        "get_device_status": {
          "description": "Get inverter operating status",
          "protocol": "modbus",
          "request": {
            "port": 502,
            "unit_id": 3,
            "function": 3,
            "address": 30201,
            "count": 2
          },
          "response_mapping": {
            "status_code": {
              "type": "U32",
              "scale": 1,
              "index": 0
            }
          }
        }
      }
    }
  }
}
